# What this scaffold builds, not what an editor or OS drops beside it —
# those live in ~/.config/git/gitignore_global, not here.

*.rpm
*.src.rpm

# Where scripts/rpm-build-lint.sh's HOME points when run via docker (so
# CI/the release job can retrieve the built RPMs, and so root-owned dnf/rpm
# config doesn't land loose in the working tree).
/.rpm-home/

node_modules/
.bun-cache/

# Written by the release job, not by hand.
CHANGELOG.md
